{
  "name": "backend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local-protocol https",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pm-tool-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pm-tool-db --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/oauth-providers": "^0.8.8",
    "@pm-tool/shared": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/node": "^24.13.6",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
