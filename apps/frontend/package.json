{
  "name": "frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "build:production": "vue-tsc --noEmit && vite build --mode production",
    "typecheck": "vue-tsc --noEmit && tsc -p worker --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:staging": "pnpm build:staging && wrangler deploy --env staging",
    "deploy:production": "pnpm build:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@pm-tool/shared": "workspace:*",
    "hono": "^4.6.0",
    "pinia": "^2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/typescript-plugin": "^3.3.11",
    "backend": "workspace:*",
    "happy-dom": "^16.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.135.0"
  }
}
