{
  "name": "frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "build:production": "vue-tsc --noEmit && vite build --mode production",
    "typecheck": "vue-tsc --noEmit && tsc -p worker --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "orval --config orval.config.ts",
    "deploy:staging": "pnpm build:staging && wrangler deploy --env staging",
    "deploy:production": "pnpm build:production && wrangler deploy --env production",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@pinia/colada": "^1.4.6",
    "@pm-tool/shared": "workspace:*",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "pinia": "^2",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/typescript-plugin": "^3.3.11",
    "backend": "workspace:*",
    "happy-dom": "^16.0.0",
    "orval": "^8.37.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.135.0"
  }
}
